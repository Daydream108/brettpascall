{
  "name": "brettpascall",
  "compatibility_date": "2026-05-08",
  "main": "worker.mjs",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/consultation"
    ]
  },
  "send_email": [
    {
      "name": "INQUIRIES",
      "destination_address": "consulting@brettpascall.com"
    }
  ],
  "ratelimits": [
    {
      "name": "INQUIRY_LIMIT",
      "namespace_id": "762304",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ]
}
