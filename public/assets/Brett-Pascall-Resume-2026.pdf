/* Brett Pascall — Editorial Operator
   Warm cream paper, deep ink, single rust accent.
   Newsreader serif × Geist sans × JetBrains Mono.
*/

:root {
  --bg: oklch(0.972 0.008 75);
  --bg-elev: oklch(0.957 0.011 75);
  --bg-deep: oklch(0.93 0.013 70);
  --ink: oklch(0.22 0.012 60);
  --ink-soft: oklch(0.36 0.01 60);
  --ink-mute: oklch(0.52 0.008 60);
  --ink-faint: oklch(0.72 0.006 60);
  --rule: oklch(0.86 0.012 70);
  --rule-soft: oklch(0.91 0.01 70);
  --accent: #b65a3a;
  --accent-ink: oklch(0.45 0.13 40);
  --max: 1240px;
  --gutter: clamp(20px, 4vw, 56px);

  --serif: "Newsreader", "Source Serif Pro", Georgia, serif;
  --sans: "Geist", "GT America", "Helvetica Neue", Helvetica, sans-serif;
  --mono: "JetBrains Mono", "IBM Plex Mono", ui-monospace, monospace;
}

[data-theme="ink"] {
  --bg: oklch(0.16 0.012 70);
  --bg-elev: oklch(0.20 0.014 70);
  --bg-deep: oklch(0.13 0.012 70);
  --ink: oklch(0.94 0.008 75);
  --ink-soft: oklch(0.80 0.008 75);
  --ink-mute: oklch(0.62 0.008 75);
  --ink-faint: oklch(0.40 0.008 75);
  --rule: oklch(0.30 0.012 70);
  --rule-soft: oklch(0.24 0.012 70);
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 16px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

body {
  /* faint paper grain */
  background-image:
    radial-gradient(circle at 20% 12%, oklch(0.93 0.018 65 / 0.4) 0%, transparent 32%),
    radial-gradient(circle at 88% 78%, oklch(0.94 0.014 60 / 0.32) 0%, transparent 36%);
  background-attachment: fixed;
}

[data-theme="ink"] body {
  background-image:
    radial-gradient(circle at 18% 14%, oklch(0.22 0.018 70 / 0.55) 0%, transparent 36%),
    radial-gradient(circle at 84% 82%, oklch(0.20 0.016 65 / 0.48) 0%, transparent 38%);
}

a { color: inherit; text-decoration: none; }

::selection { background: var(--accent); color: white; }

/* Heading family toggle */
[data-heading="serif"] h1,
[data-heading="serif"] h2,
[data-heading="serif"] h3,
[data-heading="serif"] .display { font-family: var(--serif); font-weight: 400; letter-spacing: -0.015em; }
[data-heading="sans"] h1,
[data-heading="sans"] h2,
[data-heading="sans"] h3,
[data-heading="sans"] .display { font-family: var(--sans); font-weight: 600; letter-spacing: -0.025em; }

em { font-style: italic; font-family: var(--serif); font-weight: 400; }
[data-heading="sans"] em { font-family: var(--serif); font-style: italic; font-weight: 400; }

/* ──────────────────────────────────────────────────────────
   NAV
*/
.site-nav {
  position: sticky;
  top: 0;
  z-index: 50;
  background: color-mix(in oklch, var(--bg) 88%, transparent);
  backdrop-filter: saturate(140%) blur(14px);
  -webkit-backdrop-filter: saturate(140%) blur(14px);
  border-bottom: 1px solid var(--rule-soft);
}
.site-nav__inner {
  max-width: var(--max);
  margin: 0 auto;
  padding: 18px var(--gutter);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
}
.brand__mark {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  background: var(--ink);
  color: var(--bg);
  font-family: var(--sans);
  font-weight: 600;
  font-size: 12px;
  letter-spacing: 0.04em;
  border-radius: 4px;
}
.brand__name {
  font-family: var(--serif);
  font-size: 17px;
  font-weight: 500;
  letter-spacing: -0.01em;
}
.site-nav__links {
  display: flex;
  align-items: center;
  gap: 32px;
}
.site-nav__link {
  font-size: 14px;
  color: var(--ink-soft);
  letter-spacing: -0.005em;
  position: relative;
  cursor: pointer;
  transition: color 0.18s ease;
  padding: 4px 0;
}
.site-nav__link::after {
  content: "";
  position: absolute;
  inset: auto 0 -2px 0;
  height: 1px;
  background: var(--accent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.22s ease;
}
.site-nav__link:hover { color: var(--ink); }
.site-nav__link:hover::after { transform: scaleX(1); }

.site-nav__menu {
  display: none;
  background: transparent;
  border: 1px solid var(--rule);
  width: 36px;
  height: 36px;
  border-radius: 6px;
  padding: 0;
  cursor: pointer;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
}
.site-nav__menu span {
  display: block;
  width: 16px;
  height: 1.5px;
  background: var(--ink);
}

@media (max-width: 760px) {
  .site-nav__menu { display: flex; }
  .site-nav__links {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    gap: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    padding: 12px var(--gutter) 24px;
    align-items: flex-start;
    transform-origin: top;
    transform: scaleY(0);
    opacity: 0;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }
  .site-nav__links.is-open { transform: scaleY(1); opacity: 1; }
  .site-nav__link { padding: 12px 0; font-size: 18px; width: 100%; border-bottom: 1px solid var(--rule-soft); }
}

/* ──────────────────────────────────────────────────────────
   HERO
*/
.hero {
  max-width: var(--max);
  margin: 0 auto;
  padding: 80px var(--gutter) 56px;
  position: relative;
}
.hero__grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 64px;
  align-items: center;
}
.hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--ink-mute);
  margin-bottom: 32px;
}
.hero__dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 0 3px color-mix(in oklch, var(--accent) 22%, transparent);
  animation: pulse 2.4s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
.hero__title {
  font-size: clamp(44px, 6.4vw, 84px);
  line-height: 1.02;
  margin: 0 0 28px;
  color: var(--ink);
  text-wrap: balance;
}
.hero__sub {
  font-size: clamp(17px, 1.4vw, 19px);
  line-height: 1.55;
  color: var(--ink-soft);
  max-width: 560px;
  margin: 0 0 36px;
  text-wrap: pretty;
}
.hero__sub strong {
  color: var(--ink);
  font-weight: 600;
}
.hero__cta {
  display: flex;
  flex-wrap: wrap;
  gap: 28px;
}

.hero__portrait {
  display: flex;
  justify-content: flex-end;
}
.portrait {
  position: relative;
  width: 100%;
  max-width: 380px;
  aspect-ratio: 4 / 5;
}
.portrait img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 50% 30%;
  border-radius: 4px;
  filter: contrast(1.02) saturate(0.92);
  display: block;
}
[data-theme="ink"] .portrait img { filter: contrast(0.96) saturate(0.85) brightness(0.92); }
.portrait::before {
  content: "";
  position: absolute;
  inset: 12px -12px -12px 12px;
  border: 1px solid var(--accent);
  border-radius: 4px;
  z-index: -1;
}
.portrait__caption {
  position: absolute;
  bottom: -40px;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-mute);
}
.portrait__sep { color: var(--ink-faint); }

.hero__ticker {
  margin-top: 88px;
  border-top: 1px solid var(--rule-soft);
  border-bottom: 1px solid var(--rule-soft);
  padding: 18px 0;
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--ink-mute);
}
.hero__ticker span:nth-child(even) { color: var(--accent); font-size: 7px; transform: translateY(-1px); }

@media (max-width: 880px) {
  .hero { padding-top: 48px; }
  .hero__grid { grid-template-columns: 1fr; gap: 48px; }
  .hero__portrait { justify-content: flex-start; }
  .portrait { max-width: 320px; }
}

/* ──────────────────────────────────────────────────────────
   SECTIONS — common
*/
.section {
  max-width: var(--max);
  margin: 0 auto;
  padding: 96px var(--gutter);
  border-top: 1px solid var(--rule-soft);
}
.section__head {
  margin: 32px 0 56px;
}
.section__head--row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.section__title {
  font-size: clamp(32px, 4vw, 52px);
  line-height: 1.05;
  margin: 0 0 12px;
  text-wrap: balance;
}
.section__sub {
  font-size: 17px;
  color: var(--ink-soft);
  margin: 0;
  max-width: 520px;
}

.section-label {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--ink-mute);
}
.section-label__index {
  color: var(--accent);
  font-weight: 600;
}
.section-label__rule {
  display: block;
  width: 32px;
  height: 1px;
  background: var(--ink-faint);
}

/* ARROW LINK */
.arrow-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--sans);
  font-size: 14px;
  font-weight: 500;
  color: var(--ink);
  border-bottom: 1px solid var(--ink-faint);
  padding-bottom: 4px;
  cursor: pointer;
  transition: color 0.2s ease, border-color 0.2s ease;
}
.arrow-link svg {
  transition: transform 0.22s ease;
}
.arrow-link:hover { color: var(--accent); border-color: var(--accent); }
.arrow-link:hover svg { transform: translate(2px, -2px); }
.arrow-link--small { font-size: 13px; }

/* TAG */
.tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--mono);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  padding: 5px 9px;
  border-radius: 3px;
  background: var(--bg-deep);
  color: var(--ink-soft);
  border: 1px solid var(--rule);
}
.tag--live { background: color-mix(in oklch, var(--accent) 12%, var(--bg)); color: var(--accent-ink); border-color: color-mix(in oklch, var(--accent) 30%, var(--rule)); }
.tag--wip { background: var(--bg-deep); color: var(--ink-soft); }
.tag--live::before {
  content: "";
  width: 6px; height: 6px;
  background: var(--accent);
  border-radius: 50%;
}

/* ──────────────────────────────────────────────────────────
   ABOUT
*/
.about__grid {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 80px;
  align-items: start;
}
.about__lede p {
  font-family: var(--serif);
  font-size: clamp(22px, 2.4vw, 30px);
  line-height: 1.32;
  color: var(--ink);
  margin: 0;
  text-wrap: pretty;
}
.about__body p {
  font-size: 16px;
  line-height: 1.7;
  color: var(--ink-soft);
  margin: 0 0 18px;
  max-width: 580px;
}
.about__meta {
  margin-top: 36px;
  border-top: 1px solid var(--rule);
  padding-top: 20px;
  display: grid;
  gap: 10px;
  max-width: 520px;
}
.about__meta-row {
  display: grid;
  grid-template-columns: 110px 1fr;
  gap: 24px;
  font-size: 14px;
  padding: 4px 0;
}
.about__meta-key {
  font-family: var(--mono);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--ink-mute);
  align-self: center;
}

@media (max-width: 880px) {
  .about__grid { grid-template-columns: 1fr; gap: 36px; }
}

/* ──────────────────────────────────────────────────────────
   PROJECTS
*/
.projects__list {
  display: grid;
  gap: 4px;
}
.project {
  display: grid;
  grid-template-columns: 80px 1fr;
  gap: 32px;
  padding: 36px 0;
  border-top: 1px solid var(--rule-soft);
  align-items: start;
}
.project:last-child { border-bottom: 1px solid var(--rule-soft); }
.project__index {
  font-family: var(--mono);
  font-size: 12px;
  color: var(--ink-mute);
  letter-spacing: 0.08em;
  padding-top: 4px;
}
.project__head {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 10px;
}
.project__name {
  font-size: clamp(26px, 2.6vw, 36px);
  line-height: 1.1;
  margin: 0;
}
.project__tagline {
  font-family: var(--serif);
  font-style: italic;
  font-size: 18px;
  color: var(--ink);
  margin: 0 0 14px;
}
.project__desc {
  font-size: 15px;
  line-height: 1.65;
  color: var(--ink-soft);
  max-width: 640px;
  margin: 0 0 22px;
}
.project__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.project__role {
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--ink-mute);
}
.project__soon {
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--ink-faint);
}

@media (max-width: 700px) {
  .project { grid-template-columns: 1fr; gap: 12px; }
  .project__index { padding-top: 0; }
}

/* ──────────────────────────────────────────────────────────
   WRITING — preview & cards
*/
.writing__list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4px;
  border-top: 1px solid var(--rule-soft);
}
.post-card {
  display: flex;
  flex-direction: column;
  padding: 32px 28px 32px 0;
  border-right: 1px solid var(--rule-soft);
  cursor: pointer;
  transition: background 0.18s ease;
  position: relative;
}
.post-card:last-child { border-right: none; }
.post-card:hover { background: color-mix(in oklch, var(--accent) 4%, transparent); }
.post-card:hover .post-card__cta svg { transform: translate(2px, -2px); }
.post-card__meta {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
  font-family: var(--mono);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--ink-mute);
  flex-wrap: wrap;
}
.post-card__cat { color: var(--accent); }
.post-card__sep {
  width: 3px; height: 3px;
  border-radius: 50%;
  background: var(--ink-faint);
}
.post-card__title {
  font-size: 24px;
  line-height: 1.2;
  margin: 0 0 14px;
  text-wrap: balance;
}
.post-card__excerpt {
  font-size: 14px;
  line-height: 1.6;
  color: var(--ink-soft);
  margin: 0 0 22px;
  flex: 1;
  text-wrap: pretty;
}
.post-card__cta {
  font-family: var(--sans);
  font-size: 13px;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--ink);
}
.post-card__cta svg { transition: transform 0.22s ease; }

@media (max-width: 880px) {
  .writing__list { grid-template-columns: 1fr; }
  .post-card { border-right: none; border-bottom: 1px solid var(--rule-soft); padding: 28px 0; }
  .post-card:last-child { border-bottom: none; }
}

/* ──────────────────────────────────────────────────────────
   MEDIA
*/
.media__intro {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 40px;
  align-items: start;
  margin: 32px 0 64px;
  max-width: 940px;
}
.media__badge {
  font-family: var(--mono);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--accent);
  border: 1px solid color-mix(in oklch, var(--accent) 40%, var(--rule));
  padding: 8px 12px;
  border-radius: 3px;
  white-space: nowrap;
  background: color-mix(in oklch, var(--accent) 6%, transparent);
}
.media__intro p {
  font-family: var(--serif);
  font-size: clamp(20px, 2.1vw, 26px);
  line-height: 1.4;
  margin: 0;
  color: var(--ink);
  text-wrap: pretty;
}

.media__featured {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 32px;
  padding: 36px;
  background: var(--bg-elev);
  border: 1px solid var(--rule);
  border-radius: 6px;
  margin-bottom: 64px;
  position: relative;
  overflow: hidden;
}
.media__featured::before {
  content: "";
  position: absolute;
  top: 0; left: 0;
  width: 4px; height: 100%;
  background: var(--accent);
}
.media__featured-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  border: 1px solid var(--rule);
  border-radius: 4px;
  aspect-ratio: 16 / 10;
  position: relative;
  overflow: hidden;
}
.media__featured-mark::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    repeating-linear-gradient(
      135deg,
      transparent 0,
      transparent 11px,
      var(--rule) 11px,
      var(--rule) 12px
    );
  opacity: 0.6;
}
.media__featured-mark span {
  position: relative;
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--ink-soft);
  background: var(--bg);
  padding: 6px 12px;
  border: 1px solid var(--rule);
  border-radius: 2px;
}
.media__featured-eyebrow {
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--ink-mute);
  margin-bottom: 12px;
}
.media__featured-title {
  font-size: clamp(24px, 2.6vw, 32px);
  line-height: 1.2;
  margin: 0 0 14px;
}
.media__featured-desc {
  font-size: 15px;
  line-height: 1.65;
  color: var(--ink-soft);
  margin: 0 0 22px;
  max-width: 560px;
}

.media__sublabel {
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--ink-mute);
  margin-bottom: 24px;
}
.media__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--rule-soft);
  border: 1px solid var(--rule-soft);
}
.interview {
  background: var(--bg);
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  transition: background 0.18s ease;
}
.interview:hover { background: var(--bg-elev); }
.interview__year {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  color: var(--accent);
  margin-bottom: 4px;
}
.interview__title {
  font-family: var(--serif);
  font-size: 18px;
  line-height: 1.25;
  margin: 0;
  color: var(--ink);
}
.interview__person {
  font-family: var(--sans);
  font-size: 13px;
  color: var(--ink-soft);
  font-weight: 500;
}
.interview__desc {
  font-size: 13px;
  line-height: 1.55;
  color: var(--ink-mute);
  margin: 4px 0 12px;
  flex: 1;
}
.interview__link {
  font-family: var(--sans);
  font-size: 12px;
  color: var(--ink);
  border-bottom: 1px solid var(--ink-faint);
  align-self: flex-start;
  padding-bottom: 2px;
  transition: color 0.2s ease, border-color 0.2s ease;
}
.interview__link:hover { color: var(--accent); border-color: var(--accent); }

.media__archive {
  margin-top: 32px;
  display: flex;
  justify-content: flex-end;
}

@media (max-width: 880px) {
  .media__intro { grid-template-columns: 1fr; gap: 18px; }
  .media__featured { grid-template-columns: 1fr; padding: 24px; }
  .media__grid { grid-template-columns: 1fr; }
}

/* ──────────────────────────────────────────────────────────
   OUTSIDE
*/
.outside__grid {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 64px;
  align-items: start;
}
.outside__lede p {
  font-family: var(--serif);
  font-size: clamp(20px, 2.2vw, 26px);
  line-height: 1.4;
  margin: 0;
  color: var(--ink);
  text-wrap: pretty;
}
.outside__list {
  list-style: none;
  margin: 0;
  padding: 0;
  border-top: 1px solid var(--rule-soft);
}
.outside__item {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 24px;
  padding: 22px 0;
  border-bottom: 1px solid var(--rule-soft);
  align-items: baseline;
}
.outside__label {
  font-family: var(--sans);
  font-size: 18px;
  font-weight: 500;
  color: var(--ink);
}
.outside__note {
  font-family: var(--serif);
  font-style: italic;
  font-size: 16px;
  color: var(--ink-soft);
}
@media (max-width: 700px) {
  .outside__grid { grid-template-columns: 1fr; gap: 32px; }
  .outside__item { grid-template-columns: 1fr; gap: 4px; }
}

/* ──────────────────────────────────────────────────────────
   CONTACT
*/
.contact__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: start;
}
.contact__title {
  font-size: clamp(34px, 4.2vw, 56px);
  line-height: 1.05;
  margin: 0 0 18px;
  text-wrap: balance;
}
.contact__sub {
  font-size: 17px;
  color: var(--ink-soft);
  margin: 0;
  max-width: 420px;
}
.contact__list {
  display: flex;
  flex-direction: column;
}
.contact-row {
  display: grid;
  grid-template-columns: 110px 1fr auto;
  align-items: center;
  gap: 24px;
  padding: 20px 0;
  border-top: 1px solid var(--rule-soft);
  cursor: pointer;
  transition: padding 0.22s ease, color 0.2s ease;
}
.contact-row:last-child { border-bottom: 1px solid var(--rule-soft); }
.contact-row:hover { padding-left: 8px; color: var(--accent); }
.contact-row:hover .contact-row__arrow { transform: translate(4px, -4px); color: var(--accent); }
.contact-row__label {
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--ink-mute);
}
.contact-row__value {
  font-family: var(--serif);
  font-size: clamp(20px, 2.2vw, 26px);
}
.contact-row__arrow {
  transition: transform 0.22s ease, color 0.2s ease;
  color: var(--ink-mute);
}
@media (max-width: 700px) {
  .contact__grid { grid-template-columns: 1fr; gap: 32px; }
  .contact-row { grid-template-columns: 1fr auto; }
  .contact-row__label { grid-column: 1 / -1; }
}

/* ──────────────────────────────────────────────────────────
   PAGE (writing index, post)
*/
.page {
  max-width: 920px;
  margin: 0 auto;
  padding: 64px var(--gutter) 96px;
}
.page__header { margin-bottom: 48px; }
.page__crumb {
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--ink-mute);
  margin-bottom: 28px;
}
.page__crumb a { border-bottom: 1px solid transparent; transition: border-color 0.2s ease; }
.page__crumb a:hover { border-color: var(--ink-mute); }
.page__title {
  font-size: clamp(48px, 6vw, 84px);
  line-height: 1.02;
  margin: 0 0 24px;
  text-wrap: balance;
}
.page__lede {
  font-family: var(--serif);
  font-size: clamp(20px, 1.8vw, 24px);
  line-height: 1.45;
  color: var(--ink-soft);
  margin: 0 0 24px;
  max-width: 680px;
  text-wrap: pretty;
}
.page__meta {
  display: flex;
  gap: 12px;
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--ink-mute);
}
.inline-link { color: var(--accent); border-bottom: 1px solid currentColor; }

/* Filters */
.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 20px 0;
  border-top: 1px solid var(--rule-soft);
  border-bottom: 1px solid var(--rule-soft);
  margin-bottom: 8px;
}
.filter {
  font-family: var(--sans);
  font-size: 13px;
  background: transparent;
  border: 1px solid var(--rule);
  color: var(--ink-soft);
  padding: 7px 14px;
  border-radius: 999px;
  cursor: pointer;
  transition: all 0.18s ease;
}
.filter:hover { color: var(--ink); border-color: var(--ink-faint); }
.filter.is-active {
  background: var(--ink);
  color: var(--bg);
  border-color: var(--ink);
}

/* Post list rows */
.post-list { display: flex; flex-direction: column; }
.post-row {
  display: grid;
  grid-template-columns: 130px 1fr 80px 24px;
  gap: 28px;
  padding: 32px 0;
  border-bottom: 1px solid var(--rule-soft);
  align-items: start;
  cursor: pointer;
  transition: padding 0.22s ease;
}
.post-row:hover { padding-left: 8px; }
.post-row:hover .post-row__title { color: var(--accent); }
.post-row:hover .post-row__arrow { transform: translate(4px, -4px); color: var(--accent); }
.post-row__date {
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-mute);
  padding-top: 6px;
}
.post-row__cat {
  font-family: var(--mono);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--accent);
  margin-bottom: 10px;
}
.post-row__title {
  font-size: clamp(22px, 2.4vw, 30px);
  line-height: 1.15;
  margin: 0 0 8px;
  transition: color 0.2s ease;
  text-wrap: balance;
}
.post-row__excerpt {
  font-size: 15px;
  line-height: 1.6;
  color: var(--ink-soft);
  margin: 0;
  max-width: 620px;
}
.post-row__time {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  color: var(--ink-mute);
  text-align: right;
  padding-top: 6px;
}
.post-row__arrow {
  color: var(--ink-mute);
  transition: transform 0.22s ease, color 0.2s ease;
  margin-top: 6px;
}
.post-list__empty {
  padding: 64px 0;
  text-align: center;
  color: var(--ink-mute);
  font-family: var(--serif);
  font-size: 18px;
}

@media (max-width: 700px) {
  .post-row { grid-template-columns: 1fr; gap: 4px; padding: 24px 0; }
  .post-row__time, .post-row__arrow { display: none; }
}

/* Post body */
.page--post .post__header { margin-bottom: 56px; }
.post__title {
  font-size: clamp(40px, 5.4vw, 72px);
  line-height: 1.04;
  margin: 0 0 24px;
  text-wrap: balance;
}
.post__meta {
  display: flex;
  gap: 12px;
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--ink-mute);
  align-items: center;
  flex-wrap: wrap;
}
.post__body {
  max-width: 680px;
  font-family: var(--serif);
  font-size: 19px;
  line-height: 1.7;
  color: var(--ink);
}
.post__body .post__lede {
  font-size: 22px;
  line-height: 1.5;
  color: var(--ink-soft);
  margin: 0 0 32px;
  padding-left: 16px;
  border-left: 2px solid var(--accent);
  font-style: italic;
}
.post__body p { margin: 0 0 22px; text-wrap: pretty; }
.post__signoff {
  margin-top: 48px;
  padding-top: 24px;
  border-top: 1px solid var(--rule);
  display: flex;
  gap: 14px;
  font-family: var(--mono);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--ink-mute);
}
.post__more {
  margin-top: 96px;
  padding-top: 48px;
  border-top: 1px solid var(--rule-soft);
  max-width: none;
}
.post__more .writing__list {
  grid-template-columns: 1fr 1fr;
  margin-top: 24px;
}
@media (max-width: 700px) {
  .post__more .writing__list { grid-template-columns: 1fr; }
}

/* ──────────────────────────────────────────────────────────
   FOOTER
*/
.site-footer {
  border-top: 1px solid var(--rule);
  background: var(--bg-elev);
  margin-top: 64px;
}
.site-footer__inner {
  max-width: var(--max);
  margin: 0 auto;
  padding: 64px var(--gutter) 32px;
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 48px;
  align-items: start;
}
.site-footer__name {
  font-family: var(--serif);
  font-size: 28px;
  margin-bottom: 6px;
}
.site-footer__role {
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--ink-mute);
}
.site-footer__cols {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}
.site-footer__col {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.site-footer__label {
  font-family: var(--mono);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--ink-mute);
  margin-bottom: 6px;
}
.site-footer__link {
  font-size: 14px;
  color: var(--ink-soft);
  transition: color 0.18s ease;
  cursor: pointer;
}
.site-footer__link:hover { color: var(--accent); }
.site-footer__base {
  max-width: var(--max);
  margin: 0 auto;
  padding: 24px var(--gutter);
  border-top: 1px solid var(--rule-soft);
  display: flex;
  justify-content: space-between;
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--ink-mute);
  flex-wrap: wrap;
  gap: 8px;
}
.site-footer__signature { color: var(--accent); }

@media (max-width: 760px) {
  .site-footer__inner { grid-template-columns: 1fr; gap: 40px; }
  .site-footer__cols { grid-template-columns: repeat(2, 1fr); }
}
